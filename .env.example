DATABASE_URL=postgresql://probe:probe@localhost:5434/probe

# Real (non-stub) LLM calls read this. Get one at https://aistudio.google.com/apikey
# Every command works without it if you pass --stub (StubLLMClient, no cost, no key needed).
GEMINI_API_KEY=your-key-here

# Optional overrides for the fast/capable/best model tiers (see
# src/probe/model_config.py). Only set these if the defaults there have
# gone stale — Gemini preview model ids shift over time.
# GEMINI_MODEL_FAST=gemini-3.6-flash
# GEMINI_MODEL_CAPABLE=gemini-3.5-flash
# GEMINI_MODEL_BEST=gemini-3.5-flash
# Once a Pro-class model is confirmed available on this key (see
# model_config.py), bump capable/best via these two vars alone —
# no code change needed.

# --- Moss learner-memory retrieval (see moss_client.py) ---
# The live semantic-retrieval layer for learner memory. With no
# credentials the app runs the in-process StubMossEngine (the Moss
# analogue of --stub): no key, no cost, fully offline, deterministic in
# tests. Get real credentials at https://www.moss.dev/ and set both to
# switch the live path to the real Moss cloud-built, locally-loaded index.
# MOSS_PROJECT_ID=your-project-id
# MOSS_PROJECT_KEY=your-project-key

# Name of the learner-memory index. Keep it in config, not hard-coded.
MOSS_INDEX_NAME=versa-learner-memory

# Retrieval knobs (all optional; defaults shown).
MOSS_TOP_K=5
MOSS_MIN_SCORE=0.0
MOSS_AUTO_REFRESH=false
MOSS_REFRESH_SECONDS=300

# Set true in a deployed/production config so a missing real Moss engine
# fails loudly at startup instead of silently degrading to the stub.
MOSS_REQUIRED=false

# Live retrieval engine: "moss" (real when creds present, else stub) or
# "stub" (force the in-process engine even if creds exist). "pgvector" is
# NOT valid here — the pgvector control path lives only in the benchmark.
VERSA_RETRIEVAL_ENGINE=moss

# Demo mode keeps the retrieval telemetry panel visible for judges.
VERSA_DEMO_MODE=false

# --- ElevenLabs (voice) ---
ELEVENLABS_API_KEY=
